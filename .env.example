# QuoteFlow AI — environment template.
# Copy to .env and fill in real values. NEVER commit .env or real secrets.
# Generate JWT_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# ─── Core ───────────────────────────────────────────────────────────────────
APP_ENV=development                      # development | staging | production
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/quoteflow
JWT_SECRET=                              # REQUIRED in production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
REQUIRE_VERIFIED_EMAIL=true
FRONTEND_BASE_URL=
PUBLIC_BASE_URL=
CORS_ALLOW_ORIGINS=https://dashboard.example.com

# ─── Legacy API key (webhook-side integrations only) ────────────────────────
FEEDBACK_API_KEY=

# ─── OpenAI (image analysis; empty = mock analyzer) ─────────────────────────
OPENAI_API_KEY=

# ─── Twilio (SMS/MMS/voice) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AGENT_PHONE_NUMBER=

# ─── SendGrid (transactional email) ─────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_WEBHOOK_SECRET=

# ─── Redis / Celery ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Stripe (SaaS billing) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=                             # "mock" only for local dev/tests
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
TRIAL_DAYS=14
BILLING_GRACE_DAYS=3

# ─── Rate limiting / abuse protection ───────────────────────────────────────
LOGIN_RATE_LIMIT=10
RESET_RATE_LIMIT=5
SIGNUP_RATE_LIMIT=5
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ─── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SLOW_REQUEST_MS=2000
ALERT_WEBHOOK_URL=                       # optional: Slack/Teams/PagerDuty hook

# ─── Backups (Render Postgres example) ──────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# ─── Legacy quote-payment toggles ───────────────────────────────────────────
PAYMENTS_ENABLED=false
BUSINESS_NAME=Your Company Name
DEFAULT_TAX_RATE=0.08
